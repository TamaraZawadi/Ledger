<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title">Settings</h1></div>
    </div>
  </div>

  <% if(success){ %>
  <div style="margin:1rem 2rem;padding:12px 16px;background:#e0f7ef;border-radius:8px;color:#0d5c3d;font-size:13px">
    <i class="fas fa-check-circle"></i> Settings saved successfully.
  </div>
  <% } %>

  <div style="padding:0 2rem 2rem;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">

    <!-- Business Profile -->
    <div class="dash-card" style="padding:1.5rem">
      <h2 style="font-size:15px;font-weight:600;margin-bottom:1.25rem">Business profile</h2>
      <form action="/settings/business" method="POST" class="auth-form">
        <div class="form-group"><label>Business name</label><input type="text" name="name" value="<%= business.name %>" required></div>
        <div class="form-row">
          <div class="form-group">
            <label>Type</label>
            <select name="type">
              <% ['boutique','supermarket','retail','other'].forEach(t => { %>
              <option value="<%=t%>" <%=business.type===t?'selected':''%>><%=t.charAt(0).toUpperCase()+t.slice(1)%></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group"><label>Currency</label>
            <select name="currency">
              <option value="KES" <%=business.currency==='KES'?'selected':''%>>KES</option>
              <option value="USD" <%=business.currency==='USD'?'selected':''%>>USD</option>
              <option value="UGX" <%=business.currency==='UGX'?'selected':''%>>UGX</option>
              <option value="TZS" <%=business.currency==='TZS'?'selected':''%>>TZS</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Savings rate (%)</label><input type="number" name="savingsRate" value="<%= business.savings_rate %>" min="0" max="50" step="0.5"></div>
          <div class="form-group"><label>VAT rate (%)</label><input type="number" name="vatRate" value="<%= business.vat_rate %>" min="0" max="30" step="0.5"></div>
        </div>
        <div class="form-group"><label>KRA PIN</label><input type="text" name="kraPin" value="<%= business.kra_pin || '' %>" placeholder="A000000000B"></div>
        <div class="form-group"><label>Phone</label><input type="text" name="phone" value="<%= business.phone || '' %>"></div>
        <div class="form-group"><label>Address</label><input type="text" name="address" value="<%= business.address || '' %>"></div>
        <button type="submit" class="btn-submit" style="margin-top:8px">Save business settings</button>
      </form>
    </div>

    <div style="display:flex;flex-direction:column;gap:16px">
      <!-- Users -->
      <div class="dash-card">
        <div class="card-header"><h2>Team members</h2></div>
        <table class="data-table">
          <thead><tr><th>Name</th><th>Role</th><th>Status</th><th></th></tr></thead>
          <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td style="font-size:13px"><%= u.first_name %> <%= u.last_name %><br><span style="color:#999;font-size:11px"><%= u.email %></span></td>
            <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
            <td><span style="font-size:11px;color:<%= u.is_active?'#00b87f':'#dc3545' %>"><%= u.is_active?'Active':'Inactive' %></span></td>
            <td><% if(u.id !== user.id){ %>
              <form action="/settings/users/<%=u.id%>/toggle" method="POST" style="margin:0">
                <button type="submit" style="background:none;border:none;font-size:11px;color:#888;cursor:pointer"><%= u.is_active?'Deactivate':'Activate' %></button>
              </form><% } %></td>
          </tr>
          <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Invite user -->
      <div class="dash-card" style="padding:1.5rem">
        <h2 style="font-size:15px;font-weight:600;margin-bottom:1rem">Invite team member</h2>
        <form action="/settings/invite" method="POST" class="auth-form">
          <div class="form-row">
            <div class="form-group"><label>First name</label><input type="text" name="firstName" required></div>
            <div class="form-group"><label>Last name</label><input type="text" name="lastName" required></div>
          </div>
          <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
          <div class="form-group"><label>Role</label>
            <select name="role">
              <option value="user">User (view only)</option>
              <option value="accountant">Accountant</option>
              <option value="manager">Manager</option>
            </select>
          </div>
          <button type="submit" class="btn-submit">Send invite</button>
        </form>
      </div>

      <!-- Change password -->
      <div class="dash-card" style="padding:1.5rem">
        <h2 style="font-size:15px;font-weight:600;margin-bottom:1rem">Change password</h2>
        <form action="/settings/password" method="POST" class="auth-form">
          <div class="form-group"><label>Current password</label><input type="password" name="currentPassword" required></div>
          <div class="form-group"><label>New password</label><input type="password" name="newPassword" minlength="8" required></div>
          <button type="submit" class="btn-submit">Update password</button>
        </form>
      </div>

      <!-- Sign out -->
      <div class="dash-card" style="padding:1.5rem;border:1px solid #ffe0e0;">
        <h2 style="font-size:15px;font-weight:600;margin-bottom:4px">Sign out</h2>
        <p style="font-size:13px;color:var(--text-3);margin-bottom:1.25rem">
          You are signed in as <strong><%= user.first_name %> <%= user.last_name %></strong>
          (<%= user.email %>). Signing out will clear your session and return you to the login page.
        </p>
        <form action="/auth/logout" method="POST" style="margin:0">
          <button type="submit" style="
            display:inline-flex;align-items:center;gap:8px;
            padding:10px 20px;border-radius:8px;border:none;cursor:pointer;
            background:#fff0f0;color:#c0392b;font-size:13px;font-weight:600;
            transition:background 0.2s;
          " onmouseover="this.style.background='#ffd5d5'" onmouseout="this.style.background='#fff0f0'">
            <i class="fas fa-right-from-bracket"></i> Sign out of LEDGR
          </button>
        </form>
      </div>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
