<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar"><div class="topbar-left"><button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><div><h1 class="page-title">Payroll</h1></div></div>
    <a href="/payroll/new" class="btn-add"><i class="fas fa-plus"></i> Run Payroll</a>
  </div>
  <div style="padding:1.5rem 2rem">
    <div class="dash-card">
      <div class="card-header"><h2>Payroll runs</h2></div>
      <table class="data-table">
        <thead><tr><th>Period</th><th>Employees</th><th>Gross</th><th>Net Payout</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% runs.forEach(r => { %>
        <tr>
          <td><%= new Date(r.period_year, r.period_month-1).toLocaleString('default',{month:'long'}) %> <%= r.period_year %></td>
          <td>—</td>
          <td><%= formatCurrency(r.total_gross, user.currency) %></td>
          <td style="font-weight:600"><%= formatCurrency(r.total_net, user.currency) %></td>
          <td><span style="font-size:11px;padding:2px 8px;border-radius:20px;background:<%= r.status==='paid'?'#e0f7ef':r.status==='approved'?'#E6F1FB':'#fff8e1' %>;color:<%= r.status==='paid'?'#0d5c3d':r.status==='approved'?'#0C447C':'#7a5400' %>"><%= r.status %></span></td>
          <td><a href="/payroll/<%= r.id %>" style="font-size:12px;color:#0d6efd">View →</a></td>
        </tr>
        <% }) %>
        <% if(runs.length===0){ %><tr><td colspan="6" style="text-align:center;padding:2rem;color:#888">No payroll runs yet</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
