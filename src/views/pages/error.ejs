<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body" style="background: var(--surface-0, #f4f4f0)">
<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;gap:1rem;text-align:center;padding:2rem">
  <div style="font-size:4rem;font-weight:700;color:#e24b4a"><%= code || 500 %></div>
  <h1 style="font-size:1.5rem;font-weight:500;margin:0"><%= title ? title.replace(' — LEDGR','') : 'Something went wrong' %></h1>
  <p style="color:#888;max-width:400px"><%= message || 'An unexpected error occurred.' %></p>
  <a href="/dashboard" style="margin-top:1rem;background:#1a1a1a;color:#fff;padding:10px 24px;border-radius:8px;text-decoration:none;font-size:14px">← Back to dashboard</a>
</div>
</body>
</html>
