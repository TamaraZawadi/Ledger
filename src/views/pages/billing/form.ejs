<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar"><div class="topbar-left"><button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><div><h1 class="page-title">Add Billing Schedule</h1></div></div><a href="/billing" style="font-size:13px;color:#888">← Back</a></div>
  <div style="padding:2rem;max-width:520px">
    <div class="dash-card" style="padding:2rem">
      <form action="/billing" method="POST" class="auth-form">
        <div class="form-group"><label>Bill name</label><input type="text" name="name" placeholder="e.g. Kenya Power" required></div>
        <div class="form-row">
          <div class="form-group"><label>Category</label>
            <select name="category" required>
              <option value="electricity">Electricity</option><option value="water">Water</option>
              <option value="wifi">Wi-Fi / Internet</option><option value="rent">Rent</option>
              <option value="supplier">Supplier</option><option value="other">Other</option>
            </select>
          </div>
          <div class="form-group"><label>Amount (KES)</label><input type="number" name="amount" min="1" step="0.01" required></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Billing day of month</label><input type="number" name="billingDay" min="1" max="28" placeholder="e.g. 20" required></div>
          <div class="form-group"><label>Payment method</label>
            <select name="paymentMethod">
              <option value="mpesa">M-Pesa</option><option value="bank_transfer">Bank Transfer</option>
            </select>
          </div>
        </div>
        <div class="form-group"><label>Payee number / Paybill</label><input type="text" name="payeeNumber" placeholder="e.g. 0722000000 or 522522"></div>
        <div class="form-group"><label>Account reference</label><input type="text" name="accountRef" placeholder="e.g. Your meter number"></div>
        <button type="submit" class="btn-submit">Create Schedule</button>
      </form>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
