<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">

  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title">Departments</h1></div>
    </div>
    <a href="/employees" style="font-size:13px;color:#888;text-decoration:none">← Back to employees</a>
  </div>

  <div style="padding:1.5rem 2rem">
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px">
    <% departments.forEach(d => { %>
    <div style="background:#fff;border:1px solid #e8e8e5;border-radius:10px;padding:1.5rem">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1rem">
        <h3 style="font-size:15px;font-weight:600"><%= d.name %></h3>
        <span style="background:#e8f0fe;color:#1967d2;font-size:12px;font-weight:600;padding:3px 10px;border-radius:20px">
          <%= d.employee_count || 0 %> staff
        </span>
      </div>
      <% if(d.description){ %><p style="font-size:13px;color:#888;margin-bottom:1rem"><%= d.description %></p><% } %>
      <div style="border-top:1px solid #f0f0ec;padding-top:1rem;display:flex;justify-content:space-between">
        <span style="font-size:12px;color:#888">Monthly payroll</span>
        <span style="font-size:14px;font-weight:700;color:#00b87f"><%= formatCurrency(d.total_salary||0, user.currency) %></span>
      </div>
      <a href="/employees?dept=<%= d.id %>" style="display:inline-block;margin-top:10px;font-size:12px;color:#0d6efd;text-decoration:none">View employees →</a>
    </div>
    <% }) %>
    <% if(departments.length===0){ %>
    <div class="empty-state"><i class="fas fa-sitemap"></i><p>No departments yet. They are created automatically when you register.</p></div>
    <% } %>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body>
</html>
