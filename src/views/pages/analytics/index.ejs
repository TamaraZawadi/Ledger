<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar">
    <div class="topbar-left">
      <button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
      <div><h1 class="page-title">Analytics</h1><p class="page-sub"><%= year %> overview</p></div>
    </div>
    <form method="GET" style="margin:0">
      <select name="year" onchange="this.form.submit()" style="font-size:13px;padding:6px 12px;border:1px solid #ddd;border-radius:8px">
        <% [2023,2024,2025,2026].forEach(y => { %><option value="<%=y%>" <%=year==y?'selected':''%>><%=y%></option><% }) %>
      </select>
    </form>
  </div>

  <div class="stats-grid">
    <div class="stat-card income"><div class="stat-icon"><i class="fas fa-arrow-trend-up"></i></div>
      <div class="stat-body"><span class="stat-label">Total income</span><span class="stat-val"><%= formatCurrency(totals.total_income, user.currency) %></span></div>
    </div>
    <div class="stat-card expense"><div class="stat-icon"><i class="fas fa-arrow-trend-down"></i></div>
      <div class="stat-body"><span class="stat-label">Total expenses</span><span class="stat-val"><%= formatCurrency(totals.total_expenses, user.currency) %></span></div>
    </div>
    <div class="stat-card net"><div class="stat-icon"><i class="fas fa-scale-balanced"></i></div>
      <div class="stat-body"><span class="stat-label">Net income</span><span class="stat-val <%= totals.net >= 0 ? 'positive':'negative' %>"><%= formatCurrency(totals.net, user.currency) %></span></div>
    </div>
    <div class="stat-card savings"><div class="stat-icon"><i class="fas fa-piggy-bank"></i></div>
      <div class="stat-body"><span class="stat-label">Savings (<%= totals.savingsRate %>%)</span><span class="stat-val"><%= formatCurrency(totals.net * totals.savingsRate / 100, user.currency) %></span></div>
    </div>
  </div>

  <div class="dash-grid">
    <div class="dash-card">
      <div class="card-header"><h2>Income vs Expenses — Monthly</h2></div>
      <div style="padding:1.5rem"><canvas id="monthlyChart" height="120"></canvas></div>
    </div>
    <div class="dash-side">
      <div class="dash-card">
        <div class="card-header"><h2>Expense breakdown</h2></div>
        <div style="padding:1rem"><canvas id="categoryChart" height="200"></canvas></div>
      </div>
      <div class="dash-card">
        <div class="card-header"><h2>Top expenses</h2></div>
        <table class="data-table">
          <% topExpenses.forEach(e => { %>
          <tr>
            <td style="font-size:12px"><%= e.description || 'Expense' %><br><span style="color:#999;font-size:11px"><%= e.vendor || '' %></span></td>
            <td class="right" style="font-size:12px;color:#dc3545"><%= formatCurrency(e.total, user.currency) %></td>
          </tr>
          <% }) %>
        </table>
      </div>
    </div>
  </div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
<script>
const cd = <%- JSON.stringify(chartData) %>;
new Chart(document.getElementById('monthlyChart'), {
  type: 'bar',
  data: {
    labels: cd.labels,
    datasets: [
      { label: 'Income', data: cd.income, backgroundColor: 'rgba(0,184,127,0.7)', borderRadius: 4 },
      { label: 'Expenses', data: cd.expenses, backgroundColor: 'rgba(220,53,69,0.7)', borderRadius: 4 },
    ]
  },
  options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } }
});

const cats = <%- JSON.stringify(categoryBreakdown) %>;
if (cats.length) {
  new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
      labels: cats.map(c => c.name),
      datasets: [{ data: cats.map(c => parseFloat(c.total)), backgroundColor: ['#00b87f','#dc3545','#0d6efd','#ffc107','#6f42c1','#fd7e14'] }]
    },
    options: { responsive: true, plugins: { legend: { position: 'right', labels: { font: { size: 11 } } } } }
  });
}
</script>
</body></html>
