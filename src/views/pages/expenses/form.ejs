<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/dashboard.css">
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="app-body">
<%- include('../../partials/sidebar') %>
<main class="main-content">
  <div class="topbar"><div class="topbar-left"><button class="menu-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button><div><h1 class="page-title">Log Expense</h1></div></div><a href="/expenses" style="font-size:13px;color:#888">← Back</a></div>
  <div style="padding:2rem;max-width:560px">
    <div class="dash-card" style="padding:2rem">
      <% if(error){ %><div class="alert alert-error"><%= error %></div><% } %>
      <form action="/expenses" method="POST" class="auth-form">
        <div class="form-row">
          <div class="form-group"><label>Date</label><input type="date" name="date" value="<%= expense ? expense.date : today %>" required></div>
          <div class="form-group"><label>Amount (KES)</label><input type="number" name="amount" value="<%= expense ? expense.amount : '' %>" min="0.01" step="0.01" required></div>
        </div>
        <div class="form-group"><label>Description</label><input type="text" name="description" value="<%= expense ? expense.description : '' %>" required></div>
        <div class="form-group"><label>Category</label>
          <select name="categoryId">
            <option value="">Select category…</option>
            <% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %> (<%= c.type %>)</option><% }) %>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group"><label>Vendor</label><input type="text" name="vendor" placeholder="Optional"></div>
          <div class="form-group"><label>Payment method</label>
            <select name="paymentMethod">
              <option value="cash">Cash</option><option value="mpesa">M-Pesa</option>
              <option value="bank_transfer">Bank Transfer</option><option value="card">Card</option>
            </select>
          </div>
        </div>
        <div class="form-group" style="flex-direction:row;align-items:center;gap:8px">
          <input type="checkbox" name="isPaid" id="isPaid" style="width:auto"><label for="isPaid" style="margin:0">Already paid</label>
        </div>
        <button type="submit" class="btn-submit">Save Expense</button>
      </form>
    </div>
  </div>
</main>
<script src="/js/dashboard.js"></script>
</body></html>
