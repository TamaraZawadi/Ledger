<%- include('../../partials/head') %>
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">

<div class="auth-layout">
  <div class="auth-brand">
    <a href="/" class="auth-logo"><span class="logo-mark">L</span> LEDGR</a>
    <div class="auth-brand-copy">
      <h2>Start managing your<br>business finances today.</h2>
      <div class="auth-features">
        <div class="af"><i class="fas fa-check-circle"></i> Free to get started</div>
        <div class="af"><i class="fas fa-check-circle"></i> Set up in under 5 minutes</div>
        <div class="af"><i class="fas fa-check-circle"></i> M-Pesa Daraja integrated</div>
        <div class="af"><i class="fas fa-check-circle"></i> Works for boutiques, supermarkets & retail</div>
      </div>
    </div>
  </div>

  <div class="auth-form-wrap">
    <div class="auth-form-box wide">
      <a href="/" class="auth-back-home">
        <i class="fas fa-arrow-left"></i> Back to home
      </a>
      <h1>Create your account</h1>
      <p class="auth-sub">Set up your business on LEDGR</p>

      <% if (error) { %>
      <div class="alert alert-error"><i class="fas fa-circle-exclamation"></i> <%= error %></div>
      <% } %>

      <form action="/auth/register" method="POST" class="auth-form" novalidate>

        <div class="form-section-label">Business details</div>
        <div class="form-row">
          <div class="form-group">
            <label for="businessName">Business name</label>
            <input type="text" id="businessName" name="businessName" value="<%= typeof formData !== 'undefined' ? formData.businessName || '' : '' %>" placeholder="Wanjiku's Boutique" required>
          </div>
          <div class="form-group">
            <label for="businessType">Business type</label>
            <select id="businessType" name="businessType" required>
              <option value="">Select type…</option>
              <option value="boutique" <%= (typeof formData !== 'undefined' && formData.businessType === 'boutique') ? 'selected' : '' %>>Boutique</option>
              <option value="supermarket" <%= (typeof formData !== 'undefined' && formData.businessType === 'supermarket') ? 'selected' : '' %>>Supermarket</option>
              <option value="retail" <%= (typeof formData !== 'undefined' && formData.businessType === 'retail') ? 'selected' : '' %>>Retail shop</option>
              <option value="other" <%= (typeof formData !== 'undefined' && formData.businessType === 'other') ? 'selected' : '' %>>Other</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="businessEmail">Business email <span class="optional">(optional, defaults to yours)</span></label>
          <input type="email" id="businessEmail" name="businessEmail" placeholder="info@yourbusiness.co.ke">
        </div>

        <div class="form-section-label">Your account</div>
        <div class="form-row">
          <div class="form-group">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" value="<%= typeof formData !== 'undefined' ? formData.firstName || '' : '' %>" required>
          </div>
          <div class="form-group">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" name="lastName" value="<%= typeof formData !== 'undefined' ? formData.lastName || '' : '' %>" required>
          </div>
        </div>
        <div class="form-group">
          <label for="email">Your email address</label>
          <input type="email" id="email" name="email" value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>" placeholder="you@email.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label for="password">Password <span class="optional">(min 8 characters)</span></label>
          <div class="input-pw">
            <input type="password" id="password" name="password" placeholder="••••••••" required minlength="8" autocomplete="new-password">
            <button type="button" onclick="togglePw()" tabindex="-1"><i class="fas fa-eye" id="pwIcon"></i></button>
          </div>
        </div>

        <button type="submit" class="btn-submit">Create account →</button>
      </form>

      <p class="auth-switch">Already have an account? <a href="/auth/login">Sign in</a></p>
    </div>
  </div>
</div>

<script>
  function togglePw() {
    const inp = document.getElementById('password');
    const icon = document.getElementById('pwIcon');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    icon.className = inp.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
  }
</script>
</body>
</html>
